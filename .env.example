# URL pública do app (usada para montar os links /p/{slug} e os redirects de e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transacionais (resend.com). Sem dominio verificado, o Resend so
# entrega para o e-mail cadastrado na sua conta Resend (modo sandbox/teste).
RESEND_API_KEY=
RESEND_FROM_EMAIL=PetTag <onboarding@resend.dev>

# Segredo que protege o endpoint de lembrete de vacinas (chamado por um cron).
CRON_SECRET=
